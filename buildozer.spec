# Minimum API level (für Android 14+ sollte minapi mindestens 24 sein)
android.minapi = 24

# Target API level (Ziel-API für Android 14 ist 34)
android.api = 34

# NDK API level (muss mit minapi übereinstimmen)
android.ndk_api = 24

# NDK Version (sicherstellen, dass eine moderne NDK-Version verwendet wird)
android.ndk = 25b
